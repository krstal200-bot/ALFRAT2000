rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['brand','cat','name','qty','img']);
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['pinHash']);
    }
  }
}
